# Đoạn cấu hình phục vụ trang, dùng chung cho Caddyfile (domain) và Caddyfile.ip (theo IP)
(zuimo_site) {
	encode zstd gzip

	# API: chuyển tiếp sang container api; Caddy tự thêm X-Forwarded-For để API ghi đúng IP người dùng
	handle /api/* {
		reverse_proxy api:3000 {
			# Thăm dò 5 giây một lần: khi api khởi động lại, Caddy nhận ra nó khỏe trở lại gần như ngay,
			# thay vì để người dùng nhận 503 suốt cả chu kỳ kiểm tra.
			health_uri /api/health
			health_interval 5s
			health_timeout 2s
			health_status 2xx

			# Trong lúc api đang khởi động, giữ request lại tối đa 10 giây và thử lại mỗi 0,5 giây
			# thay vì trả lỗi ngay. Người dùng thấy trang hơi chậm một nhịp, không thấy lỗi.
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	# Âm thanh luyện tập sinh sẵn: thư mục riêng, cache dài (file không đổi sau khi sinh)
	handle_path /media/* {
		root * /media
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	# Phần còn lại là web tĩnh. Trang một file: đường dẫn lạ trả về index.html,
	# file tĩnh có thật (icon, manifest) vẫn trả đúng file.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://images.pexels.com; connect-src 'self'; media-src 'self'; manifest-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		X-Frame-Options "DENY"
		-Server
	}

	# HTML và manifest: luôn kiểm tra bản mới ngay sau mỗi lần deploy
	@fresh path / /index.html /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	# JS/CSS do Vite build có hash trong tên: cache vĩnh viễn, đổi nội dung là đổi tên
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Dữ liệu học (từ vựng, sách, nét chữ): cache 1 giờ, hết hạn vẫn dùng bản cũ trong lúc tải bản mới
	@data path /data/*
	header @data Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
	# Icon, ảnh chia sẻ: cache 7 ngày (đổi logo thì đổi tên file hoặc chờ hết hạn)
	@static path *.png *.svg /robots.txt /sitemap.xml
	header @static Cache-Control "public, max-age=604800"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}
